# Database (Neon) — pooled connection string; this project uses Prisma's
# driver-adapter pattern (@prisma/adapter-pg) so there's no separate
# DIRECT_URL to wire up, unlike the classic prisma-client-js datasource setup
DATABASE_URL=postgresql://...

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Paynow Zimbabwe (PropFlow's own merchant account — subscription billing)
PAYNOW_INTEGRATION_ID=...
PAYNOW_INTEGRATION_KEY=...
PAYNOW_RETURN_URL=https://propflow.co.zw/settings/billing/success
PAYNOW_RESULT_URL=https://propflow.co.zw/api/webhooks/paynow

# Africa's Talking
AT_API_KEY=...
AT_USERNAME=sandbox
AT_SENDER_ID=PROPFLOW

# Resend
RESEND_API_KEY=re_...
RESEND_FROM=notifications@propflow.co.zw

# Cloudflare R2
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=propflow-uploads
R2_PUBLIC_URL=https://uploads.propflow.co.zw

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...

# Cron protection
CRON_SECRET=...

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=PropFlow Zimbabwe

# Monitoring
SENTRY_DSN=...
# Same DSN as SENTRY_DSN, duplicated under NEXT_PUBLIC_ so the browser bundle
# (instrumentation-client.ts) can read it too — a DSN is not a secret.
NEXT_PUBLIC_SENTRY_DSN=...
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
