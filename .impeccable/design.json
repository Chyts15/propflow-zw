  "components": [
    {
      "name": "Navigation Item",
      "kind": "nav",
      "refersTo": "nav-item-active",
      "description": "Landlord sidebar row: default and active states with a red complaint count.",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-nav-item ds-nav-item--active\" href=\"#\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"9\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"5\"/><rect x=\"14\" y=\"12\" width=\"7\" height=\"9\"/><rect x=\"3\" y=\"16\" width=\"7\" height=\"5\"/></svg><span>Dashboard</span></a><a class=\"ds-nav-item\" href=\"#\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"4\" y=\"2\" width=\"16\" height=\"20\" rx=\"2\"/><path d=\"M9 22v-4h6v4M8 6h.01M16 6h.01M12 6h.01M12 10h.01M12 14h.01M16 10h.01M16 14h.01M8 10h.01M8 14h.01\"/></svg><span>Properties</span></a></nav>",
      "css": ".ds-nav{background:#150b07;padding:12px;width:220px;display:flex;flex-direction:column;gap:4px;font-family:Inter, Arial, Helvetica, sans-serif}.ds-nav-item{display:flex;align-items:center;gap:10px;padding:8px 12px;border-radius:16px;border:1px solid transparent;color:rgba(255,255,255,.55);font-size:13px;text-decoration:none;transition:background .2s,color .2s}.ds-nav-item:hover{background:rgba(255,255,255,.06);color:#fff}.ds-nav-item:focus-visible{outline:2px solid #e8835c;outline-offset:2px}.ds-nav-item--active{border-color:#c8522a;background:rgba(200,82,42,.1);color:#c8522a}"
    },
    {
      "name": "Hero Stat",
      "kind": "card",
      "refersTo": "card-hero",
      "description": "The one Display-size number on a dashboard, with a mono eyebrow and trend.",
      "html": "<div class=\"ds-hero\"><p class=\"ds-hero-eyebrow\">ON-TIME COLLECTIONS THIS MONTH</p><div class=\"ds-hero-row\"><span class=\"ds-hero-num\">94%</span><span class=\"ds-hero-trend\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m22 7-8.5 8.5-5-5L2 17\"/><path d=\"M16 7h6v6\"/></svg>+3% vs last month</span></div></div>",
      "css": ".ds-hero{background:#1f130d;border:1px solid #3a2216;border-radius:24px;padding:24px;color:#fff;min-width:300px}.ds-hero-eyebrow{margin:0;font-family:'JetBrains Mono', ui-monospace, monospace;font-size:11px;letter-spacing:.025em;color:rgba(255,255,255,.55)}.ds-hero-row{display:flex;align-items:baseline;gap:12px;margin-top:4px}.ds-hero-num{font-family:'Plus Jakarta Sans', Inter, sans-serif;font-weight:800;font-size:48px;line-height:1}.ds-hero-trend{display:flex;align-items:center;gap:4px;font-family:Inter, Arial, Helvetica, sans-serif;font-size:13px;font-weight:500;color:#4ade80}"
    },
    {
      "name": "Stat Tile",
      "kind": "card",
      "refersTo": "card",
      "description": "Small dashboard metric: mono caption, heavy value, optional colored sub-line.",
      "html": "<div class=\"ds-stat\"><p class=\"ds-stat-label\">RENT COLLECTED</p><p class=\"ds-stat-value\">$8,400</p><p class=\"ds-stat-sub\">of $9,200 due</p></div>",
      "css": ".ds-stat{background:#1f130d;border:1px solid #3a2216;border-radius:24px;padding:16px;color:#fff;min-width:180px}.ds-stat-label{margin:0;font-family:'JetBrains Mono', ui-monospace, monospace;font-size:10px;letter-spacing:.025em;color:rgba(255,255,255,.55)}.ds-stat-value{margin:4px 0 0;font-family:'Plus Jakarta Sans', Inter, sans-serif;font-weight:800;font-size:24px}.ds-stat-sub{margin:0;font-family:Inter, Arial, Helvetica, sans-serif;font-size:12px;color:#4ade80}"
    },
    {
      "name": "Complaint Card",
      "kind": "custom",
      "refersTo": "complaint-card-critical",
      "description": "Priority-filled card with its own soft underglow; the only place glow is used.",
      "html": "<a class=\"ds-complaint\" href=\"#\"><div class=\"ds-complaint-top\"><span class=\"ds-complaint-who\">Unit 4B · Chipo Mutasa</span><span class=\"ds-complaint-time\">2h ago</span></div><p class=\"ds-complaint-title\">Water pump not working, no pressure since Monday</p></a>",
      "css": ".ds-complaint{display:block;background:#7a1410;border-radius:24px;padding:12px;color:#fff;text-decoration:none;box-shadow:0 0 20px -10px #7a1410;width:320px;font-family:Inter, Arial, Helvetica, sans-serif;transition:transform .2s}.ds-complaint:hover{transform:translateY(-1px)}.ds-complaint:focus-visible{outline:2px solid #e8835c;outline-offset:2px}.ds-complaint-top{display:flex;justify-content:space-between;align-items:center}.ds-complaint-who{font-size:13px;font-weight:600}.ds-complaint-time{font-size:11px;color:rgba(255,255,255,.6)}.ds-complaint-title{margin:2px 0 0;font-size:12px;color:rgba(255,255,255,.8)}"
    },
    {
      "name": "Status Badges",
      "kind": "chip",
      "refersTo": "badge-status",
      "description": "Hue-matched text on a 15-18% tint: payment method and rent status pills.",
      "html": "<div class=\"ds-badges\"><span class=\"ds-badge ds-badge--ecocash\">EcoCash</span><span class=\"ds-badge ds-badge--paid\">Paid</span><span class=\"ds-badge ds-badge--pending\">Pending</span><span class=\"ds-badge ds-badge--overdue\">Overdue</span></div>",
      "css": ".ds-badges{display:flex;gap:8px;font-family:Inter, Arial, Helvetica, sans-serif}.ds-badge{border-radius:9999px;padding:2px 8px;font-size:11px;font-weight:500}.ds-badge--ecocash{background:rgba(0,168,80,.18);color:#4ade80}.ds-badge--paid{background:rgba(74,222,128,.15);color:#4ade80}.ds-badge--pending{background:rgba(251,191,36,.15);color:#fbbf24}.ds-badge--overdue{background:rgba(248,113,113,.15);color:#f87171}"
    },
    {
      "name": "Filter Chips",
      "kind": "chip",
      "refersTo": "chip-filter-active",
      "description": "Pill filters in mono 11px; selected is a solid terracotta fill.",
      "html": "<div class=\"ds-chips\"><button class=\"ds-chip ds-chip--active\" type=\"button\">All</button><button class=\"ds-chip\" type=\"button\">Open</button><button class=\"ds-chip\" type=\"button\">In Progress</button></div>",
